# D2HA configuration (all optional). Never commit the real .env file.

# Where D2HA keeps its account, settings and last check results.
D2HA_DATA_DIR=/app/data

# Docker endpoint. Leave unset to use the mounted socket; with a socket proxy:
# DOCKER_HOST=tcp://docker-proxy:2375

# Hours between update checks for a fresh install (changeable later in Settings).
D2HA_CHECK_INTERVAL_HOURS=6

# GitHub token without scopes: raises the API limit from 60 to 5000 requests/hour
# for release notes. Create it at https://github.com/settings/tokens
D2HA_GITHUB_TOKEN=

# Notifications and logs only: no updates or image cleanup from D2HA.
D2HA_READ_ONLY=false

# Extra origins allowed to embed D2HA in an iframe (space separated),
# e.g. a Home Assistant dashboard: https://homeassistant.example.com
D2HA_FRAME_ANCESTORS=

# Session signing key. Leave empty: D2HA generates one and keeps it in the data folder.
D2HA_SECRET_KEY=

# DEBUG, INFO, WARNING or ERROR
D2HA_LOG_LEVEL=INFO
